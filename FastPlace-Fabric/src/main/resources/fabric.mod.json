{
  "schemaVersion": 1,
  "id": "server-mod",
  "version": "${version}",
  "name": "Server-Mod",
  "description": "Server-controlled FastPlace and FastBreak features for supported LifestealCore servers.",
  "environment": "client",
  "entrypoints": {
    "main": [
      "de.leon.fastplace.FastPlaceMod"
    ],
    "client": [
      "de.leon.fastplace.FastPlaceClient"
    ]
  },
  "mixins": [
    "fastplace.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
